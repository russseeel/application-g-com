<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.ViewModels"
             x:Class="GestionCommerciale.Views.ProduitsView"
             x:DataType="vm:ProduitsViewModel"
             Background="White">

  <UserControl.DataContext>
    <vm:ProduitsViewModel />
  </UserControl.DataContext>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Titre -->
    <TextBlock Grid.Row="0"
               Text="Gestion des Produits"
               FontSize="24"
               FontWeight="Bold"
               Foreground="#2C3E50"
               Margin="0,0,0,20" />

    <!-- Barre de filtre -->
    <Grid Grid.Row="1" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="Filtrer par catégorie :"
                 VerticalAlignment="Center"
                 Foreground="#34495E"
                 Margin="0,0,10,0" />

      <ComboBox Grid.Column="1"
                ItemsSource="{Binding CategoriesFiltre}"
                SelectedItem="{Binding FiltreCategorie}"
                Height="35"
                VerticalContentAlignment="Center" />

      <Button Grid.Column="2"
              Content="Filtrer"
              Click="OnFiltrerClick"
              Background="#9B59B6"
              Foreground="White"
              Height="35"
              Padding="20,0"
              Margin="10,0,0,0"
              CornerRadius="4"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center" />

      <Button Grid.Column="4"
              Content="Rafraîchir"
              Click="OnRafraichirClick"
              Background="#95A5A6"
              Foreground="White"
              Height="35"
              Padding="20,0"
              CornerRadius="4"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center" />
    </Grid>

    <!-- DataGrid pour afficher les produits -->
    <Border Grid.Row="2"
            BorderBrush="#BDC3C7"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,0,0,20"
            Background="White">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Produits}" Background="White" x:Name="ProduitsListControl">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.Template>
            <ControlTemplate>
              <StackPanel>
                <!-- En-têtes -->
                <Grid Background="#ECF0F1" Height="40">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="1" Text="Nom" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="3" Text="Prix" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="4" Text="Stock" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="5" Text="Catégorie" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                  <TextBlock Grid.Column="6" Text="Statut" FontWeight="Bold" Foreground="#2C3E50"
                             VerticalAlignment="Center" Margin="10,0" />
                </Grid>

                <!-- Lignes de données -->
                <ItemsPresenter />
              </StackPanel>
            </ControlTemplate>
          </ItemsControl.Template>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" x:Name="RowBorder">
                <Grid Height="40" PointerPressed="OnRowClick" Cursor="Hand" x:Name="RowGrid">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding Id}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" />
                  <TextBlock Grid.Column="1" Text="{Binding Nom}"
                             FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" FontSize="13" />
                  <TextBlock Grid.Column="2" Text="{Binding DescriptionTronquee}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" />
                  <TextBlock Grid.Column="3" Text="{Binding PrixUnitaire}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" Text="{Binding Stock}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding Categorie}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" />
                  <TextBlock Grid.Column="6" Text="{Binding Statut}"
                             VerticalAlignment="Center" Margin="10,0" FontSize="13" FontWeight="SemiBold" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Formulaire de saisie -->
    <Border Grid.Row="3"
            Background="#ECF0F1"
            CornerRadius="4"
            Padding="20"
            Margin="0,0,0,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Titre du formulaire -->
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="Informations du Produit"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,15" />

        <!-- Ligne 1 : Nom et Catégorie -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
          <TextBlock Text="Nom *" Margin="0,0,0,5" Foreground="#34495E" />
          <TextBox Text="{Binding Nom}" Height="35" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,10">
          <TextBlock Text="Catégorie" Margin="0,0,0,5" Foreground="#34495E" />
          <ComboBox ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategorie}"
                    Height="35"
                    VerticalContentAlignment="Center" />
        </StackPanel>

        <!-- Ligne 2 : Prix et Stock -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,10">
          <TextBlock Text="Prix Unitaire (€) *" Margin="0,0,0,5" Foreground="#34495E" />
          <TextBox Text="{Binding PrixUnitaire}" Height="35" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
          <TextBlock Text="Stock *" Margin="0,0,0,5" Foreground="#34495E" />
          <TextBox Text="{Binding Stock}" Height="35" />
        </StackPanel>

        <!-- Ligne 3 : Description -->
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,10">
          <TextBlock Text="Description" Margin="0,0,0,5" Foreground="#34495E" />
          <TextBox Text="{Binding Description}"
                   Height="60"
                   AcceptsReturn="True"
                   TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Boutons d'action et message de statut -->
    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Boutons -->
      <StackPanel Grid.Row="0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left"
                  Spacing="10"
                  Margin="0,0,0,10">

        <Button Content="Ajouter"
                Click="OnAjouterClick"
                Background="#27AE60"
                Foreground="White"
                Height="40"
                Padding="25,0"
                CornerRadius="4"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />

        <Button Content="Modifier"
                Click="OnModifierClick"
                Background="#F39C12"
                Foreground="White"
                Height="40"
                Padding="25,0"
                CornerRadius="4"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />

        <Button Content="Supprimer"
                Click="OnSupprimerClick"
                Background="#E74C3C"
                Foreground="White"
                Height="40"
                Padding="25,0"
                CornerRadius="4"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
      </StackPanel>

      <!-- Message de statut -->
      <Border Grid.Row="1"
              Background="#D5DBDB"
              CornerRadius="4"
              Padding="15,10">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#2C3E50"
                   FontWeight="Medium" />
      </Border>
    </Grid>

  </Grid>
</UserControl>
