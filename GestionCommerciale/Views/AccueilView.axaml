<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GestionCommerciale.Views.AccueilView"
             Background="#F8FAFC">

    <!-- Styles -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <!-- DataContext uniquement pour le Designer -->
    <Design.DataContext>
        <vm:AccueilViewModel/>
    </Design.DataContext>

    <!-- UI -->
    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock
            Text="GESTION COMMERCIALE - DASHBOARD"
            FontSize="32"
            FontWeight="Bold"
            FontFamily="Segoe UI"
            HorizontalAlignment="Center"
            Margin="0,0,0,60"
            Foreground="#2563EB"/>

        <!-- Boutons -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Spacing="20">

            <Button Content="Gérer les Clients"
                    Command="{Binding ManageClientsCommand}"
                    Height="60"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"/>

            <Button Content="Gérer les Produits"
                    Command="{Binding ManageProductsCommand}"
                    Height="60"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"/>

            <Button Content="Gérer les Commandes"
                    Command="{Binding ManageOrdersCommand}"
                    Height="60"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"/>

        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="2"
                Background="#E2E8F0"
                CornerRadius="6"
                Padding="20,12"
                HorizontalAlignment="Center"
                Margin="0,60,0,0">
            <TextBlock
                Text="{Binding StatusMessage}"
                Foreground="#64748B"
                FontSize="14"
                FontFamily="Segoe UI"/>
        </Border>

    </Grid>
</UserControl>
