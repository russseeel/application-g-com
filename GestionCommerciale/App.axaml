<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GestionCommerciale.App"
             RequestedThemeVariant="Dark">
  
  <Application.Resources>
    <SolidColorBrush x:Key="MainBackground">#121212</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackground">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellow">#F1C40F</SolidColorBrush>
    <SolidColorBrush x:Key="AccentYellowHover">#D4AC0D</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#B3B3B3</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#333333</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  
</Application>